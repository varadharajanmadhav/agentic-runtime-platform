# ==============================================================
# ARP — Agentic Runtime Platform
# Copy this file to .env and fill in your values
# ==============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://agent:agent@localhost:5432/agentruntime

# ── Redis / BullMQ ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Qdrant ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Ollama ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini ─────────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# ── Groq ──────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Agentic Runtime Platform

# ── API Server ────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# ── Web UI ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001

# ── Model Routing ─────────────────────────────────────────────
# Options: ollama, openai, anthropic, google, groq, openrouter
DEFAULT_LOW_COMPLEXITY_PROVIDER=ollama
DEFAULT_LOW_COMPLEXITY_MODEL=qwen2.5-coder:7b
DEFAULT_MEDIUM_COMPLEXITY_PROVIDER=ollama
DEFAULT_MEDIUM_COMPLEXITY_MODEL=qwen2.5-coder:32b
DEFAULT_HIGH_COMPLEXITY_PROVIDER=anthropic
DEFAULT_HIGH_COMPLEXITY_MODEL=claude-sonnet-4-5

# ── Embedding ─────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
